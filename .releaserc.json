{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true,
      "channel": "beta"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node tools/scripts/update-versions.js ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "nx run dapp:build:ci"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npx nx reset"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "nx run dapp:build:ci:electron"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "nx run electron-dapp:build:ci"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "apps/electron-dapp/dist/*.dmg"
          },
          {
            "path": "apps/electron-dapp/dist/*.zip"
          },
          {
            "path": "apps/electron-dapp/dist/*.exe"
          },
          {
            "path": "apps/electron-dapp/dist/*.AppImage"
          },
          {
            "path": "apps/electron-dapp/dist/*.blockmap"
          },
          {
            "path": "apps/electron-dapp/dist/latest*.yml"
          }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package.json", "apps/electron-dapp/package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
