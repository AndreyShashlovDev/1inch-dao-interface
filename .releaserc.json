{
  "branches": [
    "main",
    {
      "name": "dev",
      "prerelease": true,
      "channel": "beta"
    },
    {
      "name": "new-project-structure",
      "prerelease": "alpha",
      "channel": "alpha"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node --loader ts-node/esm ./scripts/update-version.ts ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "pnpm run build:libs:all"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "BASE_HREF=/interface/ pnpm run build:dapp"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "ELECTRON_BUNDLE=true pnpm run build:dapp"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "pnpm --dir apps/electron-dapp run release"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "pnpm run publish"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "apps/electron-dapp/dist/*.dmg"
          },
          {
            "path": "apps/electron-dapp/dist/*.zip"
          },
          {
            "path": "apps/electron-dapp/dist/*.exe"
          },
          {
            "path": "apps/electron-dapp/dist/*.AppImage"
          },
          {
            "path": "apps/electron-dapp/dist/*.blockmap"
          },
          {
            "path": "apps/electron-dapp/dist/latest*.yml"
          }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json",
          "apps/electron-dapp/package.json",
          "apps/dapp/package.json",
          "apps/electron-dapp/package.json",
          "libs/core/package.json",
          "libs/models/package.json",
          "libs/sdk/package.json",
          "libs/integration-layer/package.json",
          "libs/ui-components/package.json",
          "libs/widgets/package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
